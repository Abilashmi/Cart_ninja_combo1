/* Offer ladders ("ladder:<id>", app/utils/offer-ladder.shared.js): text bars
   above the coupon cards. Optional button: copies its code, or puts it on the
   Shopify cart (/cart/update.js discount, so every checkout path gets it).
   Optional auto-apply: when the cart has enough items the reached offer's code
   goes on the cart and the ladder's other codes come off; the shopper's own
   codes stay. Cart changes are seen through PerformanceObserver (any theme or
   app calling /cart/add, change, update); only when a ladder uses auto-apply. */
var LADDER=createOfferLadder();
var _ladders=[],_ladderBusy=false,_ladderAgain=false,_ladderWatching=false,_ladderLastPut='';
/* The theme's Add to cart button (placement, and ladders sized like it). */
var ATC_SELECTORS=[
  '.product-form__submit',
  '.product__submit button[type="submit"]',
  'form[action*="/cart/add"] button[type="submit"]',
  '[name="add"]',
  '.btn--add-to-cart',
  '.product-form button[type="submit"]',
  '.shopify-payment-button__button',
];
function findAtcButton(){
  for(var i=0;i<ATC_SELECTORS.length;i++){
    var b=document.querySelector(ATC_SELECTORS[i]);
    if(b)return b;
  }
  return null;
}
/* Width 'same as Add to cart' (the whole banner, or one offer ladder): the
   node takes the Add to cart button's width and left edge (a ladder also at
   least its height, --psl-atc-h). No button found, or it is hidden = full width. */
function fitToAtc(slot){
  var atc=findAtcButton(),r=atc&&atc.getBoundingClientRect();
  /* A small (icon-only) button is no guide: under 160px wide = full width. */
  if(!r||r.width<160||!slot.isConnected){slot.style.width='';slot.style.marginLeft='';slot.style.removeProperty('--psl-atc-h');return;}
  var parent=slot.parentNode.getBoundingClientRect();
  if(!parent.width)return; /* not shown yet: fit() runs again after placement */
  var left=Math.max(0,Math.min(Math.round(r.left-parent.left),Math.round(parent.width-r.width)));
  slot.style.width=Math.min(Math.round(r.width),Math.round(parent.width))+'px';
  slot.style.maxWidth='100%';
  slot.style.marginLeft=left+'px';
  slot.style.setProperty('--psl-atc-h',Math.round(r.height)+'px');
}
/* Fit now, again once the widget has moved next to the button, and whenever the page or the button resizes. */
function watchAtcFit(node){
  var fit=function(){if(node.isConnected)fitToAtc(node);};
  fit();
  setTimeout(fit,0);setTimeout(fit,400);
  window.addEventListener('resize',fit);
  var atc=findAtcButton();
  if(atc&&window.ResizeObserver){try{new ResizeObserver(fit).observe(atc);}catch(_e){}}
}
function ladderDraw(x){
  var h=LADDER.html(x.L,{show:x.show,done:x.done});
  if(h!==x.html){x.html=h;x.el.innerHTML=h;}
}
function ladderCss(){
  if(document.getElementById('ps-ladder-css'))return;
  var st=document.createElement('style');st.id='ps-ladder-css';st.textContent=LADDER.css;document.head.appendChild(st);
}
function ladderMount(el,L){
  ladderCss();
  var x={el:el,L:L,show:0,done:false,html:''};
  _ladders.push(x);
  ladderDraw(x);
  if(L.boxSize==='atc')watchAtcFit(el);
  if(L.look==='rotate'&&L.tiers.length>1){
    x.timer=setInterval(function(){
      if(!el.isConnected){clearInterval(x.timer);return;}
      if(document.hidden)return;
      x.show=(x.show+1)%L.tiers.length;ladderDraw(x);
    },L.interval*1000);
  }
  if(L.button)el.addEventListener('click',function(e){
    var btn=e.target.closest('.psl-btn');
    if(!btn||btn.disabled)return;
    var b=L.button;
    if(b.action==='copy'){
      ladderCopy(b.code);
      x.done=true;ladderDraw(x);
      setTimeout(function(){x.done=false;ladderDraw(x);},2500);
      return;
    }
    btn.disabled=true;
    ladderApplyCode(b.code).then(function(ok){
      x.done=!!ok;x.html='';ladderDraw(x);
    });
  });
  if(L.autoApply&&L.tiers.some(function(t){return t.qty&&t.code;})){
    ladderWatch();
    ladderSync();
  }
}
/* Copy a code without moving the page: the clipboard API first; the old
   textarea way only when that's missing or refused, fixed on screen and
   focused with preventScroll (an off-page textarea at top:-9999px made the
   browser scroll to the top on every Copy, like a reload). */
function csCopyFallback(code){
  var x=window.scrollX,y=window.scrollY,active=document.activeElement;
  try{
    var ta=document.createElement('textarea');
    ta.value=code;ta.setAttribute('readonly','');
    ta.style.cssText='position:fixed;top:0;left:0;width:1px;height:1px;opacity:0;pointer-events:none;';
    document.body.appendChild(ta);
    try{ta.focus({preventScroll:true});}catch(_f){ta.focus();}
    ta.setSelectionRange(0,ta.value.length);
    document.execCommand('copy');document.body.removeChild(ta);
  }catch(_e){}
  try{if(active&&active.focus)active.focus({preventScroll:true});}catch(_a){}
  if(window.scrollX!==x||window.scrollY!==y)window.scrollTo(x,y);
}
function csCopy(code){
  if(navigator.clipboard&&navigator.clipboard.writeText&&window.isSecureContext!==false){
    navigator.clipboard.writeText(code).catch(function(){csCopyFallback(code);});
  }else csCopyFallback(code);
}
function ladderCopy(code){csCopy(code);}
function ladderReadCart(){
  return fetch('/cart.js',{credentials:'same-origin',cache:'no-store'})
    .then(function(r){return r.ok?r.json():null;})
    .catch(function(){return null;});
}
function ladderCartCodes(cart){
  return (cart&&Array.isArray(cart.discount_codes)?cart.discount_codes:[]).map(function(d){return d&&d.code;}).filter(Boolean).map(String);
}
function ladderPutCodes(list){
  return fetch('/cart/update.js',{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json',Accept:'application/json'},body:JSON.stringify({discount:list.join(',')})})
    .then(function(r){return r.ok?r.json():null;})
    .catch(function(){return null;});
}
/* The button's Apply: adds the code to the cart's codes. Resolves true once
   the cart holds it (Shopify checks at checkout whether the order qualifies). */
function ladderApplyCode(code){
  var up=code.toUpperCase();
  function has(cart){return ladderCartCodes(cart).some(function(c){return c.toUpperCase()===up;});}
  return ladderReadCart().then(function(cart){
    if(has(cart))return true;
    return ladderPutCodes(ladderCartCodes(cart).concat([code])).then(function(after){
      if(after&&Array.isArray(after.discount_codes))return has(after);
      /* A cart answer without discount_codes: Shopify's discount link sets the code for checkout. */
      return fetch('/discount/'+encodeURIComponent(code)+'?redirect=%2Fcart.js',{credentials:'same-origin'})
        .then(function(r){return r.ok;}).catch(function(){return false;});
    });
  }).catch(function(){return false;});
}
function ladderSync(){
  if(_ladderBusy){_ladderAgain=true;return;}
  _ladderBusy=true;
  ladderReadCart().then(function(cart){
    _ladders=_ladders.filter(function(x){return x.el.isConnected;});
    if(!cart||!_ladders.length)return;
    var count=LADDER.cartCount(cart);
    var list=ladderCartCodes(cart),changed=false;
    _ladders.forEach(function(x){var next=LADDER.codesFor(x.L,count,list);if(next){list=next;changed=true;}});
    /* Never the same change twice in a row: a code Shopify drops (or the shopper took off) can't loop. */
    var key=count+'|'+list.join(',');
    if(!changed||_ladderLastPut===key)return;
    _ladderLastPut=key;
    return ladderPutCodes(list);
  }).catch(function(){}).then(function(){
    _ladderBusy=false;
    if(_ladderAgain){_ladderAgain=false;ladderSync();}
  });
}
function ladderWatch(){
  if(_ladderWatching)return;
  _ladderWatching=true;
  var t=null;
  function soon(){clearTimeout(t);t=setTimeout(ladderSync,350);}
  if(window.PerformanceObserver){
    try{
      new PerformanceObserver(function(list){
        list.getEntries().forEach(function(e){
          var p=String(e.name||'').replace(/^https?:\/\/[^\/]+/,'').split('?')[0];
          if(/\/cart\/(add|change|update|clear)(\.js)?$/.test(p))soon();
        });
      }).observe({type:'resource'});
    }catch(_e){}
  }
  document.addEventListener('visibilitychange',function(){if(!document.hidden)soon();});
  window.addEventListener('pageshow',function(e){if(e.persisted)soon();});
}

/* textOnly: a text offer (id "text:...", no code): heading + subtext only, no code panel, no Copy button. */
