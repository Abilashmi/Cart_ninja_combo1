{%- comment -%}
  Shopper language for BRIX's storefront scripts (app/i18n/storefront.shared.js).
  English pages load nothing: the scripts carry their English. When the shopper
  browses in a language BRIX has, this loads brix_i18n_<lang>.js (generated by
  `npm run i18n:storefront`) before the BRIX scripts, which then show that
  language. Any other language shows English. The live list is
  app/i18n/config.js LOCALES without en and BETA_LOCALES (checked by
  tests/i18n/storefront.test.mjs). Render it before a BRIX script tag; the file
  runs once per page however many blocks render it.
{%- endcomment -%}
{%- liquid
  assign bx_live = 'hi,ta,es' | split: ','
  assign bx_lang = request.locale.iso_code | split: '-' | first | downcase
-%}
{%- if bx_live contains bx_lang -%}
  <script src="{{ 'brix_i18n_' | append: bx_lang | append: '.js' | asset_url }}" defer></script>
{%- endif -%}
