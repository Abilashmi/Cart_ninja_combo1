# Makes getenv('SHOPIFY_API_KEY') resolve on Apache/mod_php hosting (Hostinger)
# so the X-Forge-Secret check in db_proxy.php / progress_bar.php / etc. actually
# enforces instead of silently no-op'ing. Must match SHOPIFY_API_KEY in the
# Node app's fly.toml / .env.
<IfModule mod_env.c>
  SetEnv SHOPIFY_API_KEY "9f7189f9faf11f0771c1ef2f81c42b8d"
  # Login password for promo_admin.php — change this to your own value,
  # then log out and back in with the new password.
  SetEnv PROMO_ADMIN_PASSWORD "HjLoiP781g5yrsRcpFmE"

  # Agency Dashboard (agencydashboard_c) server-to-server integration.
  # install_shop.php / uninstall_shop.php notify it of real Shopify
  # installs/uninstalls, and store_install_status.php answers its
  # install-state checks. Without these, all of that silently no-ops —
  # which is why an already-installed store was still bounced to the
  # App Store.
  #   - AGENCY_DASHBOARD_INTERNAL_SECRET must be byte-identical to the
  #     value set on the Agency Dashboard (Fly secret of the same name).
  #   - AGENCY_DASHBOARD_URL is that app's public base URL, no trailing slash.
  SetEnv AGENCY_DASHBOARD_INTERNAL_SECRET "24a6f7e698655643d42af07fedc68fa18c3a59a20c70629e639da67a92d789ac"
  SetEnv AGENCY_DASHBOARD_URL "https://REPLACE_WITH_AGENCY_DASHBOARD_HOST"
</IfModule>
