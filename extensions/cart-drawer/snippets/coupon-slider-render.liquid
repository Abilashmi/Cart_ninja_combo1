   paths), own icon image, icon size / colour / show, subtitle font, "Copied"
   colours. Only safe CSS goes into style attributes. */
var CS_ICON_PATHS={
  discount: '<path d="M3.25 5.5c0-1.242 1.007-2.25 2.25-2.25.414 0 .75.336.75.75s-.336.75-.75.75-.75.336-.75.75-.336.75-.75.75-.75-.336-.75-.75Z"/><path d="M12.78 7.22c.293.293.293.768 0 1.06l-4.5 4.5c-.293.293-.767.293-1.06 0-.293-.292-.293-.767 0-1.06l4.5-4.5c.293-.293.767-.293 1.06 0Z"/><path d="M9 8c0 .553-.448 1-1 1s-1-.447-1-1c0-.552.448-1 1-1s1 .448 1 1Z"/><path d="M12 13c.552 0 1-.447 1-1 0-.552-.448-1-1-1s-1 .448-1 1c0 .553.448 1 1 1Z"/><path d="M3.25 14.5c0 1.243 1.007 2.25 2.25 2.25.414 0 .75-.335.75-.75 0-.414-.336-.75-.75-.75s-.75-.335-.75-.75c0-.414-.336-.75-.75-.75s-.75.336-.75.75Z"/><path d="M16.75 14.5c0 1.243-1.007 2.25-2.25 2.25-.414 0-.75-.335-.75-.75 0-.414.336-.75.75-.75s.75-.335.75-.75c0-.414.336-.75.75-.75s.75.336.75.75Z"/><path d="M16.75 5.5c0-1.242-1.007-2.25-2.25-2.25-.414 0-.75.336-.75.75s.336.75.75.75.75.336.75.75.336.75.75.75.75-.336.75-.75Z"/><path d="M16 8.25c.414 0 .75.336.75.75v2c0 .415-.336.75-.75.75s-.75-.335-.75-.75v-2c0-.414.336-.75.75-.75Z"/><path d="M11 16.75c.414 0 .75-.335.75-.75 0-.414-.336-.75-.75-.75h-2c-.414 0-.75.336-.75.75 0 .415.336.75.75.75h2Z"/><path d="M4 8.25c.414 0 .75.336.75.75v2c0 .415-.336.75-.75.75s-.75-.335-.75-.75v-2c0-.414.336-.75.75-.75Z"/><path d="M11 4.75c.414 0 .75-.336.75-.75s-.336-.75-.75-.75h-2c-.414 0-.75.336-.75.75s.336.75.75.75h2Z"/>',
  gift: '<path d="M7.835 9.5h-.96c-.343 0-.625-.28-.625-.628 0-.344.28-.622.619-.622.242 0 .463.142.563.363l.403.887Z"/><path d="M10.665 9.5h.96c.343 0 .625-.28.625-.628 0-.344-.28-.622-.619-.622-.242 0-.463.142-.563.363l-.403.887Z"/><path fill-rule="evenodd" d="M8.5 4h-3.25c-1.519 0-2.75 1.231-2.75 2.75v2.25h1.25c.414 0 .75.336.75.75s-.336.75-.75.75h-1.25v2.75c0 1.519 1.231 2.75 2.75 2.75h3.441c-.119-.133-.191-.308-.191-.5v-2c0-.414.336-.75.75-.75s.75.336.75.75v2c0 .192-.072.367-.191.5h4.941c1.519 0 2.75-1.231 2.75-2.75v-2.75h-2.75c-.414 0-.75-.336-.75-.75s.336-.75.75-.75h2.75v-2.25c0-1.519-1.231-2.75-2.75-2.75h-4.75v2.25c0 .414-.336.75-.75.75s-.75-.336-.75-.75v-2.25Zm.297 3.992c-.343-.756-1.097-1.242-1.928-1.242-1.173 0-2.119.954-2.119 2.122 0 1.171.95 2.128 2.125 2.128h.858c-.595.51-1.256.924-1.84 1.008-.41.058-.694.438-.635.848.058.41.438.695.848.636 1.11-.158 2.128-.919 2.803-1.53.121-.11.235-.217.341-.322.106.105.22.213.34.322.676.611 1.693 1.372 2.804 1.53.41.059.79-.226.848-.636.059-.41-.226-.79-.636-.848-.583-.084-1.244-.498-1.839-1.008h.858c1.176 0 2.125-.957 2.125-2.128 0-1.168-.946-2.122-2.119-2.122-.83 0-1.585.486-1.928 1.242l-.453.996-.453-.996Z"/>',
  shipping: '<path fill-rule="evenodd" d="M4.75 4.5a.75.75 0 0 0 0 1.5h3.25a1 1 0 0 1 0 2h-4.75a.75.75 0 0 0 0 1.5h3a.75.75 0 0 1 0 1.5h-2.5a.75.75 0 0 0 0 1.5h.458a2.5 2.5 0 1 0 4.78.75h3.024a2.5 2.5 0 1 0 4.955-.153 1.75 1.75 0 0 0 1.033-1.597v-1.22a1.75 1.75 0 0 0-1.326-1.697l-1.682-.42a.25.25 0 0 1-.18-.174l-.426-1.494a2.75 2.75 0 0 0-2.645-1.995h-6.991Zm2.75 9a1 1 0 1 1-2 0 1 1 0 0 1 2 0Zm8 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0Z"/>',
  star: '<path d="M11.128 4.123c-.453-.95-1.803-.95-2.256 0l-1.39 2.912-3.199.421c-1.042.138-1.46 1.422-.697 2.146l2.34 2.222-.587 3.172c-.192 1.034.901 1.828 1.825 1.327l2.836-1.54 2.836 1.54c.924.501 2.017-.293 1.825-1.327l-.587-3.172 2.34-2.222c.762-.724.345-2.008-.697-2.146l-3.2-.421-1.389-2.912Z"/>',
  percent: '<path fill-rule="evenodd" d="M11.527 3.327c-.6-1.306-2.455-1.306-3.054 0a1.68 1.68 0 0 1-2.112.874c-1.347-.5-2.66.813-2.16 2.16a1.68 1.68 0 0 1-.874 2.112c-1.306.6-1.306 2.455 0 3.054a1.68 1.68 0 0 1 .874 2.112c-.5 1.347.813 2.659 2.16 2.16a1.68 1.68 0 0 1 2.112.874c.6 1.306 2.455 1.306 3.054 0a1.68 1.68 0 0 1 2.112-.874c1.347.499 2.66-.813 2.16-2.16a1.68 1.68 0 0 1 .874-2.112c1.306-.6 1.306-2.455 0-3.054a1.68 1.68 0 0 1-.874-2.112c.5-1.347-.813-2.66-2.16-2.16a1.68 1.68 0 0 1-2.112-.874Zm-2.527 4.923a1 1 0 1 1-2 0 1 1 0 0 1 2 0Zm3.53.53-4 4a.75.75 0 1 1-1.06-1.06l4-4a.75.75 0 1 1 1.06 1.06Zm.47 3.47a1 1 0 1 1-2 0 1 1 0 0 1 2 0Z"/>',
  cash: '<path d="M9.5 6.5a.75.75 0 0 1 1.5 0v.25h.75a.75.75 0 0 1 0 1.5h-2.25a.5.5 0 0 0 0 1h1a2 2 0 1 1 0 4v.25a.75.75 0 0 1-1.5 0v-.25h-.75a.75.75 0 0 1 0-1.5h2.25a.5.5 0 0 0 0-1h-1a2 2 0 1 1 0-4v-.25Z"/><path fill-rule="evenodd" d="M17 10a7 7 0 1 1-14 0 7 7 0 0 1 14 0Zm-1.5 0a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0Z"/>',
};
function csHex(v){return typeof v==='string'&&/^#[0-9a-f]{3,8}$/i.test(v.trim())?v.trim():null;}
function csPx(v,min,max){var n=Number(v);return v===''||v==null||!isFinite(n)?null:Math.max(min,Math.min(max,Math.round(n)));}
function csIcon(s,size,color,defaultShow){
  var show=s.iconShow===undefined||s.iconShow===null?defaultShow:s.iconShow!==false;
  if(!show)return'';
  var px=csPx(s.iconSize,8,48)||size;
  var img=typeof s.iconImage==='string'&&/^https:\/\/[^\s"'<>()]+$/.test(s.iconImage.trim())?s.iconImage.trim():null;
  if(img)return'<img src="'+escapeHtmlJs(img)+'" alt="" width="'+px+'" height="'+px+'" style="width:'+px+'px;height:'+px+'px;object-fit:contain;display:block;flex-shrink:0;">';
  var paths=CS_ICON_PATHS[s.icon]||CS_ICON_PATHS.discount;
  return'<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" width="'+px+'" height="'+px+'" fill="'+(csHex(s.iconColor)||color)+'" style="display:block;flex-shrink:0;">'+paths+'</svg>';
}
function csSubCss(s,size){
  var px=csPx(s.subFontSize,6,24),w=/^[1-9]00$/.test(String(s.subFontWeight||''))?String(s.subFontWeight):null,c=csHex(s.subColor);
  return'font-size:'+(px||size)+'px;'+(w?'font-weight:'+w+';':'')+(c?'color:'+c+';opacity:1;':'');
}
/* Copied colours ride on the button (data-copied-*), read by the click handler. */
function csCopiedAttrs(s){
  return' data-copied-bg="'+escapeHtmlJs(csHex(s.copiedBgColor)||'#10b981')+'" data-copied-text="'+escapeHtmlJs(csHex(s.copiedTextColor)||'#ffffff')+'"';
}

/* textOnly: a text offer (id "text:...", no code): heading + subtext only, no code panel, no Copy button. */
function buildCard(tpl,s,code,h,sub,timerData,textOnly){
  var fs=parseInt(s.fontSize)||13;
  var br=parseInt(s.borderRadius)||6;
  var p=parseInt(s.padding)||16;
  var bg=s.bgColor||'#fff';
  var tc=s.textColor||'#111827';
  var ac=s.accentColor||'#3b82f6';
  var bc=s.buttonColor||'#3b82f6';
  var btc=s.buttonTextColor||'#ffffff';
  var bt1=s.buttonText||'Copy Code';
  var bt3=s.buttonText||'Copy';

  var card=document.createElement('div');
  card.className='ps-card';

  if(tpl==='template1'){
    /* ── Template 1: Classic Banner ─────────────────────────────────────
       Left accent bar · ROW: [heading + subtext] [Copy Code btn]
       Card must be wide enough that text never wraps per-character.       */
    card.style.cssText=
      'background:'+bg+';'
      +'border-left:4px solid '+ac+';'
      +'border-radius:'+br+'px;'
      +'padding:16px 18px;'
      +'box-shadow:0 2px 12px rgba(0,0,0,0.07);'
      +'display:flex;flex-direction:column;'
      +'flex:0 0 320px;min-width:320px;box-sizing:border-box;';
    card.innerHTML=
      '<div style="display:flex;flex-direction:row;align-items:center;justify-content:space-between;gap:14px;">'
        +csIcon(s,22,ac,false)
        +'<div style="flex:1;min-width:100px;overflow:hidden;">'
          +'<div style="font-weight:800;font-size:'+(fs+2)+'px;color:'+tc+';line-height:1.3;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">'+h+'</div>'
          +'<div class="ps-sub" style="color:'+tc+';opacity:0.6;margin-top:3px;line-height:1.4;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;'+csSubCss(s,fs-1)+'">'+sub+'</div>'
        +'</div>'
        +(textOnly?'':'<button class="ps-btn" type="button" data-code="'+code+'"'+csCopiedAttrs(s)+' style="'
          +'background:'+bc+';color:'+btc+';border:none;'
          +'padding:9px 16px;border-radius:'+br+'px;'
          +'font-size:12px;font-weight:700;flex-shrink:0;cursor:pointer;white-space:nowrap;">'
          +bt1
        +'</button>')
      +'</div>'
      +timerStripHtml(timerData);

  }else if(tpl==='template2'){
    /* ── Template 2: Ticket ──────────────────────────────────────────────
       Punched-circle ticket: left code panel | right heading+subtext+btn  */
    card.style.cssText=
      'background:'+bg+';'
      +'border-radius:'+br+'px;'
      +'display:flex;flex-direction:column;'
      +'box-shadow:0 4px 20px rgba(0,0,0,0.08);'
      +'flex:0 0 320px;min-width:320px;'
      +'box-sizing:border-box;';
    card.innerHTML=
      '<div style="display:flex;flex-direction:row;overflow:visible;position:relative;align-items:stretch;">'
        +'<div style="position:absolute;width:20px;height:20px;background:#f9fafb;border-radius:50%;left:-10px;top:50%;transform:translateY(-50%);z-index:2;box-shadow:0 0 6px rgba(0,0,0,0.12);"></div>'
        +'<div style="position:absolute;width:20px;height:20px;background:#f9fafb;border-radius:50%;right:-10px;top:50%;transform:translateY(-50%);z-index:2;box-shadow:0 0 6px rgba(0,0,0,0.12);"></div>'
        +(textOnly?'':'<div style="width:100px;flex-shrink:0;background:linear-gradient(180deg,'+ac+'30 0%,'+ac+'15 100%);display:flex;flex-direction:column;align-items:center;justify-content:center;padding:14px 8px;border-right:2px dashed '+ac+'40;border-top-left-radius:'+br+'px;border-bottom-left-radius:'+br+'px;">'
          +'<span style="font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:1.2px;color:'+ac+';margin-bottom:8px;display:block;white-space:nowrap;">Your Code</span>'
          +'<span style="font-size:12px;font-weight:900;font-family:monospace;color:'+ac+';text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:90%;">'+code+'</span>'
        +'</div>')
        +'<div style="flex:1;padding:14px 16px;display:flex;flex-direction:column;justify-content:center;gap:5px;min-width:0;">'
          +'<div style="display:flex;align-items:center;gap:8px;min-width:0;">'+csIcon(s,20,ac,false)
          +'<div style="font-size:'+(fs+2)+'px;font-weight:800;color:'+tc+';line-height:1.3;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0;">'+h+'</div></div>'
          +'<div class="ps-sub" style="color:'+tc+';opacity:0.6;line-height:1.4;margin-bottom:6px;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;'+csSubCss(s,fs-1)+'">'+sub+'</div>'
          +(textOnly?'':'<button class="ps-btn" type="button" data-code="'+code+'"'+csCopiedAttrs(s)+' style="'
            +'background:'+bc+';color:'+btc+';border:none;'
            +'padding:7px 14px;border-radius:'+br+'px;'
            +'font-size:12px;font-weight:700;align-self:flex-start;cursor:pointer;white-space:nowrap;">'
            +bt1
          +'</button>')
        +'</div>'
      +'</div>'
      +(timerData&&timerData.timerEnabled?('<div style="padding:0 16px 14px;">'+timerStripHtml(timerData)+'</div>'):'');

  }else if(tpl==='template3'){
    /* ── Template 3: Bold & Vibrant ──────────────────────────────────────
       COLUMN: [icon + heading+subtext] then [code pill + Copy btn]        */
    card.style.cssText=
      'background:'+bg+';'
      +'border-radius:'+br+'px;'
      +'padding:16px 18px;'
      +'display:flex;flex-direction:column;gap:12px;'
      +'box-shadow:0 2px 12px rgba(0,0,0,0.07);'
      +'border:1px solid '+ac+'20;'
      +'flex:0 0 280px;min-width:280px;box-sizing:border-box;';
    card.innerHTML=
      '<div style="display:flex;align-items:flex-start;gap:10px;">'
        +(function(){var ic=csIcon(s,20,ac,true);return ic?'<div class="ps-icon-box" style="min-width:38px;min-height:38px;padding:4px;box-sizing:border-box;border-radius:9px;background:'+ac+'15;display:flex;align-items:center;justify-content:center;flex-shrink:0;">'+ic+'</div>':'';})()
        +'<div style="flex:1;min-width:0;">'
          +'<div style="font-size:'+(fs+1)+'px;font-weight:700;color:'+tc+';line-height:1.3;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">'+h+'</div>'
          +'<div class="ps-sub" style="color:'+tc+';opacity:0.55;line-height:1.4;margin-top:2px;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;'+csSubCss(s,fs-1)+'">'+sub+'</div>'
        +'</div>'
      +'</div>'
      +(textOnly?'':'<div style="display:flex;align-items:center;gap:8px;">'
        +'<div style="flex:1;padding:7px 10px;border-radius:6px;border:1.5px dashed '+ac+'55;color:'+ac+';font-size:12px;font-weight:700;font-family:monospace;text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">'+code+'</div>'
        +'<button class="ps-btn" type="button" data-code="'+code+'"'+csCopiedAttrs(s)+' style="'
          +'background:'+bc+';color:'+btc+';border:none;'
          +'padding:8px 14px;border-radius:'+br+'px;'
          +'font-size:12px;font-weight:700;flex-shrink:0;cursor:pointer;white-space:nowrap;">'
          +bt3
        +'</button>'
      +'</div>')
      +timerStripHtml(timerData);

  }

  return card;
}


function renderSlider(el,data,ctx){
  var tpl=data.selectedTemplate||'template1';
  var r=getStyles(data,tpl);
  var def=r.def,map=r.map,conds=r.conds||[];
  var titleCfg=(def&&typeof def.title==='object')?def.title:{};
  var titleText=(titleCfg&&titleCfg.text!==undefined)?String(titleCfg.text):'Apply Coupon';
  var titleFontSize=parseInt(titleCfg&&titleCfg.fontSize,10);
  if(!titleFontSize||isNaN(titleFontSize))titleFontSize=14;
  var titleColor=(titleCfg&&titleCfg.textColor)?String(titleCfg.textColor):'#111827';
  var titleAlign=(titleCfg&&titleCfg.alignment)?String(titleCfg.alignment):'left';
  if(['left','center','right'].indexOf(titleAlign)===-1)titleAlign='left';
  var normalizedMap={};
  Object.keys(map||{}).forEach(function(k){normalizedMap[normalizeId(k)]=map[k];});
  var explicitIds=asArray(
    data&&Array.isArray(data.selectedCouponsGlobal)&&data.selectedCouponsGlobal.length
      ?data.selectedCouponsGlobal
      :data.selectedTemplateCoupon
  ).map(function(id){return normalizeId(id);}).filter(Boolean);
  var styleIds=Object.keys(map||{})
    .map(function(key){return normalizeId(key);})
    .filter(function(key){return key&&!/^\d+$/.test(key);});
  var conditionIds=(conds||[])
    .map(function(cond){return normalizeId(cond&&cond.couponId);})
    .filter(Boolean);
  var ids=unique([].concat(explicitIds,styleIds,conditionIds));
  if(!ids.length){el.innerHTML='<p style="color:#6b7280;font-size:14px;padding:16px;">No coupons configured.</p>';return;}

  var itemsToRender=[];

  ids.forEach(function(item){
    var isObj=item&&typeof item==='object';
    var id=isObj?item.id:item;
    if(!id)return;

    var nid=normalizeId(id);
    /* ov = per-coupon style overrides from temp*CouponStyle (couponCode, headingText, subtextText + colors) */
    var ov=(map&&map[id])||normalizedMap[nid]||{};
    var s=Object.assign({},def,ov);

    /* cond = display condition rules only (displayCondition, productHandles etc.) */
    var cond=findCondition(conds,id);
    if(!cond.displayCondition&&ov.displayCondition)cond=ov;
    if(!matchesCondition(cond,ctx))return;

    var rawStoredCode=isObj?item.code:null;
    /* Ignore codes that are purely numeric - they are GID tails saved by mistake */
    var storedCode=(rawStoredCode&&!/^\d+$/.test(rawStoredCode))?rawStoredCode:null;
    var storedH=isObj&&item.h!==undefined?item.h:null;
    var storedSub=isObj&&item.s!==undefined?item.s:null;

    /* couponCode: item.code (selectedTemplateCoupon) -> ov.couponCode (temp*CouponStyle) -> fallback */
    var ovCode=(ov.couponCode&&!/^\d+$/.test(ov.couponCode))?ov.couponCode:null;
    var sCode=(s.couponCode&&!/^\d+$/.test(s.couponCode))?s.couponCode:null;
    /* custom:<code> = a code added via "+ Custom Coupon" (created outside BRIX); the id carries the code itself */
    var customCode=nid.indexOf('custom:')===0?nid.slice(7):null;
    /* text:<id> = a text offer (no code): only its heading and subtext show */
    var textOnly=nid.indexOf('text:')===0||ov.textOnly===true;
    var code=textOnly?'':(storedCode||ovCode||sCode||customCode||nid.split('/').pop());

    /* headingText: item.h -> ov.headingText (per-coupon) -> template default */
    var h=storedH!==null?storedH:(ov.headingText!==undefined?ov.headingText:(s.headingText||code));
    /* subtextText: item.s -> ov.subtextText (per-coupon) -> template default */
    var sub=storedSub!==null?storedSub:(ov.subtextText!==undefined?ov.subtextText:(s.subtextText||''));

    /* Merchant-typed text goes into innerHTML: escape it (the admin preview shows it as plain text too). */
    itemsToRender.push({style:s,code:escapeHtmlJs(code),heading:escapeHtmlJs(h),subtext:escapeHtmlJs(sub),textOnly:textOnly});
  });

  if(!itemsToRender.length){
    el.innerHTML='<p style="color:#6b7280;font-size:14px;padding:16px;">No coupons available for this product.</p>';
    return;
  }

  /* One coupon: nothing to slide, so no side arrows and the card fills the row */
  var single=itemsToRender.length===1;
  el.innerHTML=
    '<div class="ps-slider'+(single?' ps-slider--single':'')+'">'
      +'<div class="ps-section-title" style="text-align:'+titleAlign+';color:'+titleColor+';font-size:'+titleFontSize+'px;font-weight:700;margin-bottom:10px;line-height:1.2;">'+titleText+'</div>'
      +'<div class="ps-slider-row">'
        +(single?'':'<button class="ps-nav ps-prev" aria-label="Previous coupon">&#8592;</button>')
        +'<div class="ps-coupon-wrapper"></div>'
        +(single?'':'<button class="ps-nav ps-next" aria-label="Next coupon">&#8594;</button>')
      +'</div>'
    +'</div>';

  var w=el.querySelector('.ps-coupon-wrapper');
  var prv=el.querySelector('.ps-prev');
  var nxt=el.querySelector('.ps-next');

  // The countdown strip now lives inside each card (see buildCard's
  // timerStripHtml call), below the button — matching where the admin
  // Preview panel shows it, instead of a single bar floating above the
  // widget title outside any card. startCouponTimer runs after the cards
  // exist in the DOM since it queries for their .ps-timer-text elements.
  itemsToRender.forEach(function(item){
    w.appendChild(buildCard(tpl,item.style,item.code,item.heading,item.subtext,data,item.textOnly));
  });

  startCouponTimer(el,data,el.dataset.shop);

  /* Nav state: disable prev at start, next at end */
  function updateNavState(){
    var atStart=w.scrollLeft<=2;
    var atEnd=w.scrollLeft+w.clientWidth>=w.scrollWidth-2;
    if(prv){prv.disabled=atStart;prv.style.opacity=atStart?'0.35':'1';}
    if(nxt){nxt.disabled=atEnd;nxt.style.opacity=atEnd?'0.35':'1';}
  }

  /* Scroll by roughly one card width */
  var cardW=(itemsToRender.length>0&&w.firstChild)?w.firstChild.offsetWidth+12:280;
  if(nxt)nxt.addEventListener('click',function(){w.scrollBy({left:cardW,behavior:'smooth'});});
  if(prv)prv.addEventListener('click',function(){w.scrollBy({left:-cardW,behavior:'smooth'});});

  w.addEventListener('scroll',updateNavState);
  window.addEventListener('resize',updateNavState);
  setTimeout(updateNavState,120);

  /* Copy to clipboard */
  el.addEventListener('click',function(e){
    var btn=e.target.closest('.ps-btn');
    if(!btn)return;
    var c=btn.dataset.code,t=btn.innerText;
    if(!c)return;
    try{
      var ta=document.createElement('textarea');
      ta.value=c;
      ta.style.cssText='position:absolute;left:-9999px;top:-9999px;width:1px;height:1px;';
      document.body.appendChild(ta);ta.focus();ta.setSelectionRange(0,ta.value.length);
      document.execCommand('copy');document.body.removeChild(ta);
    }catch(_e){}
    if(navigator.clipboard&&navigator.clipboard.writeText){
      navigator.clipboard.writeText(c).catch(function(){});
    }
    var prevBg=btn.style.background,prevCol=btn.style.color;
    btn.innerText='Copied!';btn.style.background=btn.getAttribute('data-copied-bg')||'#10b981';btn.style.color=btn.getAttribute('data-copied-text')||'#fff';
    setTimeout(function(){btn.innerText=t;btn.style.background=prevBg;btn.style.color=prevCol;},2000);
  });
}

customElements.define('ps-coupon-slider',class extends HTMLElement{
  connectedCallback(){
    if(this._psInit)return;
    this._psInit=true;
    var el=this,shop=normalizeText(el.dataset.shop||(window.Shopify&&window.Shopify.shop));

    function placeWidget(apiPlacement){
      var raw=apiPlacement||el.dataset.placement||'above_atc';
      // normalize all value variants → above_atc / below_atc
      var placement=(raw==='above_cart'||raw==='top')?'above_atc':(raw==='below_cart'||raw==='bottom')?'below_atc':raw;
      if(placement==='custom'){el.style.display='block';return;}
      var atcSelectors=[
        '.product-form__submit',
        '.product__submit button[type="submit"]',
        'form[action*="/cart/add"] button[type="submit"]',
        '[name="add"]',
        '.btn--add-to-cart',
        '.product-form button[type="submit"]',
        '.shopify-payment-button__button',
      ];
      var atcBtn=null;
      for(var i=0;i < atcSelectors.length;i++){
        atcBtn=document.querySelector(atcSelectors[i]);
        if(atcBtn)break;
      }
      el.style.display='block';
      if(atcBtn){
        var anchor=atcBtn.closest('form')||atcBtn.parentNode;
        if(placement==='below_atc'){
          anchor.parentNode.insertBefore(el,anchor.nextSibling);
        }else{
          anchor.parentNode.insertBefore(el,anchor);
        }
      }
    }

    if(!shop){
      el.style.display='block';
      el.innerHTML='<p style="color:#6b7280;font-size:14px;padding:16px;">No coupons available.</p>';
      return;
    }
    if(_cache[shop]){
      getDisplayContext(el).then(function(ctx){renderSlider(el,_cache[shop],ctx);placeWidget(_cache[shop].widgetPlacement);});
      return;
    }
    var encodedShop=encodeURIComponent(shop);
    // Direct call to the PHP backend (not the Shopify App Proxy). Relies on
    // config.php's Access-Control-Allow-Origin: * — no custom headers here,
    // since those trigger a CORS preflight config.php doesn't allowlist.
    var proxyAPI='https://int.thebrix.io/save_coupon_slider_widget.php?shopdomain='+encodedShop;

    function requestJson(url){
      return fetch(url)
        .then(function(r){
          if(!r.ok)throw new Error('HTTP '+r.status);
          return r.text();
        })
        .then(function(body){
          try{return JSON.parse(body);}catch(_e){throw new Error('Invalid JSON response');}
        });
    }

    requestJson(proxyAPI)
      .then(function(res){
        if(!res||res.status!=='success'){
          el.style.display='block';
          el.innerHTML='<p style="color:#6b7280;font-size:14px;padding:16px;">No coupons available.</p>';
          return;
        }
        /* Plan gating: on Free, Coupon Lock Pro is Preview Only — the
           backend already forces is_enabled off, but never trust the
           client alone. On the live storefront, leave the element hidden.
           In the theme editor (design mode), show an upgrade placeholder
           so the merchant understands why the app embed is empty. */
        if(!res.data.is_enabled){
          if(el.dataset.designMode==='true'){
            el.style.display='block';
            el.innerHTML='<div style="padding:16px;border:1.5px dashed #d1d5db;border-radius:8px;color:#6b7280;font-size:13px;text-align:center;">🔒 Coupon Banner is not available on your current plan.<br>Upgrade to enable this widget on your storefront.</div>';
          }
          return;
        }
        _cache[shop]=res.data;
        return getDisplayContext(el).then(function(ctx){
          renderSlider(el,res.data,ctx);
          placeWidget(res.data.widgetPlacement);
        });
      })
      .catch(function(err){
        console.error('[Coupon Slider] load failed:',err&&err.message?err.message:err);
        el.style.display='block';
        el.innerHTML='<p style="color:#ef4444;font-size:14px;padding:16px;">Error loading coupons.</p>';
      });
  }
});
})();
</script>
