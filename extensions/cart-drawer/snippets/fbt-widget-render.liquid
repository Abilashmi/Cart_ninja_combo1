{%- comment -%}
  BRIX Frequently Bought Together: the place on the product page where the
  widget goes. Everything else (settings, which products, the look, adding to
  cart) is assets/brix_fbt.js, built from app/storefront/fbt-runtime.js and
  app/utils/fbt-core.shared.js. in_section: rendered by the "FBT Widget"
  section block, which the merchant placed themselves (never moved).
{%- endcomment -%}
{%- if product -%}
  <div
    data-brix-fbt
    data-shop="{{ shop.permanent_domain }}"
    data-product-id="{{ product.id }}"
    data-product-handle="{{ product.handle }}"
    data-collection-ids="{{ product.collections | map: 'id' | join: ',' }}"
    data-collection-handles="{{ product.collections | map: 'handle' | join: ',' }}"
    data-money-format="{{ shop.money_format | strip_html | escape }}"
    data-in-section="{% if in_section %}1{% endif %}"
    data-design-mode="{{ request.design_mode }}"
    style="display:none"
  ></div>
  <script src="{{ 'brix_fbt.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
