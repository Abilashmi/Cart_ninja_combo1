// Session-only Prisma schema — SQLite, no MySQL dependency.
// Kept separate from prisma/schema.prisma (MySQL) so Fly.io never needs a
// live MySQL connection just to store/read Shopify login sessions.
generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/@prisma/session-client"
}

datasource db {
  provider = "sqlite"
  url      = env("SESSION_DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  // @shopify/shopify-app-session-storage-prisma's pollForTable() does a raw
  // existence check for a table named exactly `session` (lowercase) — a
  // case-sensitive check against SQLite's own sqlite_master catalog, which
  // does NOT match the `Session` table Prisma creates by default from this
  // model's name. Without this @@map, session storage silently breaks in
  // production while looking completely fine in local dev (SQLite still
  // lets Prisma's typed CRUD methods work against `Session` either way —
  // only this one specific raw check cares about the exact physical name).
  @@map("session")
}
