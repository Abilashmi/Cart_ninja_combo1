          +'<div style="display:flex;align-items:center;gap:8px;min-width:0;">'+csIcon(s,20,ac,false)
          +'<div style="font-size:'+(fs+2)+'px;font-weight:800;color:'+tc+';line-height:1.3;min-width:0;'+wrap+'">'+h+'</div></div>'
          +'<div class="ps-sub" style="color:'+tc+';opacity:0.6;line-height:1.4;margin-bottom:6px;'+wrap+csSubCss(s,fs-1)+'">'+sub+'</div>'
          +(textOnly?'':'<button class="ps-btn" type="button" data-code="'+code+'"'+csCopiedAttrs(s)+' style="'
            +'background:'+bc+';color:'+btc+';border:none;'
            +'padding:7px 14px;border-radius:'+br+'px;'
            +'font-size:12px;font-weight:700;align-self:flex-start;max-width:100%;line-height:1.25;cursor:pointer;'+wrap+'">'
            +bt1
          +'</button>')
        +'</div>'
      +'</div>'
      +(timerData&&timerData.timerEnabled?('<div style="padding:0 16px 14px;">'+timerStripHtml(timerData)+'</div>'):'');

  }else if(tpl==='template3'){
    /* ── Template 3: Bold & Vibrant ──────────────────────────────────────
       COLUMN: [icon + heading+subtext] then [code pill + Copy btn]        */
    card.style.cssText=
      'background:'+bg+';'
      +'border-radius:'+br+'px;'
      +'padding:'+p+'px '+(p+2)+'px;'
      +'display:flex;flex-direction:column;gap:12px;'
      +'box-shadow:0 2px 12px rgba(0,0,0,0.07);'
      +'border:1px solid '+ac+'20;'
      +size+'box-sizing:border-box;';
    card.innerHTML=
      '<div style="display:flex;align-items:flex-start;gap:10px;">'
        +(function(){var ic=csIcon(s,20,ac,true);return ic?'<div class="ps-icon-box" style="min-width:38px;min-height:38px;padding:4px;box-sizing:border-box;border-radius:9px;background:'+ac+'15;display:flex;align-items:center;justify-content:center;flex-shrink:0;">'+ic+'</div>':'';})()
        +'<div style="flex:1;min-width:0;">'
          +'<div style="font-size:'+(fs+1)+'px;font-weight:700;color:'+tc+';line-height:1.3;'+wrap+'">'+h+'</div>'
          +'<div class="ps-sub" style="color:'+tc+';opacity:0.55;line-height:1.4;margin-top:2px;'+wrap+csSubCss(s,fs-1)+'">'+sub+'</div>'
        +'</div>'
      +'</div>'
      +(textOnly?'':'<div style="display:flex;align-items:center;gap:8px;margin-top:auto;">'
        +'<div style="flex:1;min-width:0;padding:7px 10px;border-radius:6px;border:1.5px dashed '+ac+'55;color:'+ac+';font-size:12px;font-weight:700;font-family:monospace;text-align:center;white-space:normal;word-break:break-all;">'+code+'</div>'
        +'<button class="ps-btn" type="button" data-code="'+code+'"'+csCopiedAttrs(s)+' style="'
          +'background:'+bc+';color:'+btc+';border:none;'
          +'padding:8px 14px;border-radius:'+br+'px;'
          +'font-size:12px;font-weight:700;flex-shrink:0;max-width:45%;line-height:1.25;cursor:pointer;'+wrap+'">'
          +bt3
        +'</button>'
      +'</div>')
      +timerStripHtml(timerData);

  }

  return card;
}


function renderSlider(el,data,ctx){
  var tpl=data.selectedTemplate||'template1';
  var r=getStyles(data,tpl);
  var def=r.def,map=r.map,conds=r.conds||[];
  /* Headings: title = above the whole banner (not saved = "Apply Coupon"); ladderTitle /
     cardsTitle = optional own headings above the offer ladders / the coupon cards (not saved = none). */
  function headingHtml(cfg,cls,fallback){
    cfg=(cfg&&typeof cfg==='object')?cfg:{};
    var text=cfg.text!==undefined&&cfg.text!==null?String(cfg.text):fallback;
    if(text.trim()==='')return '';
    var size=parseInt(cfg.fontSize,10);
    size=(!size||isNaN(size))?14:Math.max(10,Math.min(32,size));
    var color=/^#[0-9a-f]{3,8}$/i.test(String(cfg.textColor||''))?String(cfg.textColor):'#111827';
    var align=['left','center','right'].indexOf(cfg.alignment)!==-1?cfg.alignment:'left';
    return '<div class="'+cls+'" style="text-align:'+align+';color:'+color+';font-size:'+size+'px;font-weight:700;margin-bottom:10px;line-height:1.2;">'+escapeHtmlJs(text)+'</div>';
  }
  var normalizedMap={};
  Object.keys(map||{}).forEach(function(k){normalizedMap[normalizeId(k)]=map[k];});
  var explicitIds=asArray(
    data&&Array.isArray(data.selectedCouponsGlobal)&&data.selectedCouponsGlobal.length
      ?data.selectedCouponsGlobal
      :data.selectedTemplateCoupon
  ).map(function(id){return normalizeId(id);}).filter(Boolean);
  var styleIds=Object.keys(map||{})
    .map(function(key){return normalizeId(key);})
    .filter(function(key){return key&&!/^\d+$/.test(key);});
  var conditionIds=(conds||[])
    .map(function(cond){return normalizeId(cond&&cond.couponId);})
    .filter(Boolean);
  var ids=unique([].concat(explicitIds,styleIds,conditionIds));
  if(!ids.length){el.innerHTML='<p style="color:#6b7280;font-size:14px;padding:16px;">No coupons configured.</p>';return;}

  var itemsToRender=[];

  ids.forEach(function(item){
    var isObj=item&&typeof item==='object';
    var id=isObj?item.id:item;
    if(!id)return;

    var nid=normalizeId(id);
    /* ov = per-coupon style overrides from temp*CouponStyle (couponCode, headingText, subtextText + colors) */
    var ov=(map&&map[id])||normalizedMap[nid]||{};
    var s=Object.assign({},def,ov);

    /* cond = display condition rules only (displayCondition, productHandles etc.) */
    var cond=findCondition(conds,id);
    if(!cond.displayCondition&&ov.displayCondition)cond=ov;
    if(!matchesCondition(cond,ctx))return;

    /* ladder:<id> = an offer ladder: its own colours (never the template's), the template's corners. */
    if(nid.indexOf('ladder:')===0||ov.ladder===true){
      var L=LADDER.normalize(Object.assign({},ov,{borderRadius:s.borderRadius}));
      if(L.tiers.length)itemsToRender.push({ladder:L});
      return;
    }

    var rawStoredCode=isObj?item.code:null;
    /* Ignore codes that are purely numeric - they are GID tails saved by mistake */
    var storedCode=(rawStoredCode&&!/^\d+$/.test(rawStoredCode))?rawStoredCode:null;
    var storedH=isObj&&item.h!==undefined?item.h:null;
    var storedSub=isObj&&item.s!==undefined?item.s:null;

    /* couponCode: item.code (selectedTemplateCoupon) -> ov.couponCode (temp*CouponStyle) -> fallback */
    var ovCode=(ov.couponCode&&!/^\d+$/.test(ov.couponCode))?ov.couponCode:null;
    var sCode=(s.couponCode&&!/^\d+$/.test(s.couponCode))?s.couponCode:null;
    /* custom:<code> = a code added via "+ Custom Coupon" (created outside BRIX); the id carries the code itself */
    var customCode=nid.indexOf('custom:')===0?nid.slice(7):null;
    /* text:<id> = a text offer (no code): only its heading and subtext show */
    var textOnly=nid.indexOf('text:')===0||ov.textOnly===true;
    var code=textOnly?'':(storedCode||ovCode||sCode||customCode||nid.split('/').pop());

    /* headingText: item.h -> ov.headingText (per-coupon) -> template default */
    var h=storedH!==null?storedH:(ov.headingText!==undefined?ov.headingText:(s.headingText||code));
    /* subtextText: item.s -> ov.subtextText (per-coupon) -> template default */
    var sub=storedSub!==null?storedSub:(ov.subtextText!==undefined?ov.subtextText:(s.subtextText||''));

    /* Merchant-typed text goes into innerHTML: escape it (the admin preview shows it as plain text too). */
    itemsToRender.push({style:s,code:escapeHtmlJs(code),heading:escapeHtmlJs(h),subtext:escapeHtmlJs(sub),textOnly:textOnly});
  });

  if(!itemsToRender.length){
    el.innerHTML='<p style="color:#6b7280;font-size:14px;padding:16px;">No coupons available for this product.</p>';
    return;
  }

  /* Offer ladders go above the cards, full width, in their saved order. */
  var ladders=itemsToRender.filter(function(item){return item.ladder;});
  var cards=itemsToRender.filter(function(item){return !item.ladder;});
  /* One coupon: nothing to slide, so no side arrows and the card fills the row */
  var single=cards.length===1;
  /* Banner layout (Coupon Banner → Layout): carousel = the sliding row,
     list = stacked full width, grid = 2 columns (1 on phones). Not saved =
     carousel, how it always looked here. */
  var layout=['list','carousel','grid'].indexOf(data.layout)!==-1?data.layout:'carousel';
  var slides=layout==='carousel'&&cards.length>1;
  el.innerHTML=
    '<div class="ps-slider'+(single?' ps-slider--single':'')+' ps-slider--'+layout+'">'
      +headingHtml(def&&def.title,'ps-section-title','Apply Coupon')
      +(ladders.length?headingHtml(def&&def.ladderTitle,'ps-group-title ps-ladders-title','')+'<div class="ps-ladders">'+ladders.map(function(){return '<div class="ps-ladder"></div>';}).join('')+'</div>':'')
      +(cards.length?headingHtml(def&&def.cardsTitle,'ps-group-title ps-cards-title',''):'')
      +(cards.length?'<div class="ps-slider-row">'
        +(slides?'<button class="ps-nav ps-prev" aria-label="Previous coupon">&#8592;</button>':'')
        +'<div class="ps-coupon-wrapper"></div>'
        +(slides?'<button class="ps-nav ps-next" aria-label="Next coupon">&#8594;</button>':'')
      +'</div>':'')
    +'</div>';

  /* Banner width (Coupon Banner → Layout): full (default) | atc = same as the
     Add to cart button | custom = bannerWidthPx (200-800, never wider than the screen). */
  var bannerBox=el.querySelector('.ps-slider');
  if(def.bannerWidth==='custom'){var bw=csPx(def.bannerWidthPx,200,800);if(bw)bannerBox.style.maxWidth=bw+'px';}
  else if(def.bannerWidth==='atc')watchAtcFit(bannerBox);
  Array.prototype.forEach.call(el.querySelectorAll('.ps-ladder'),function(slot,i){ladderMount(slot,ladders[i].ladder);});
  /* Only ladders, each as wide as Add to cart (and the banner itself full
     width): the title takes that width and place too, so it sits centred over
     them (it was centred over the full width, off to one side). */
  /* The offer ladders' own heading always sits over them, so it follows the same rule with cards too. */
  if(ladders.length&&def.bannerWidth!=='atc'&&def.bannerWidth!=='custom'&&ladders.every(function(x){return x.ladder.boxSize==='atc';})){
    var titleEl=el.querySelector('.ps-section-title'),ladderTitleEl=el.querySelector('.ps-ladders-title');
    if(titleEl&&!cards.length)watchAtcFit(titleEl);
    if(ladderTitleEl)watchAtcFit(ladderTitleEl);
  }
  if(!cards.length)return;

  var w=el.querySelector('.ps-coupon-wrapper');
  var prv=el.querySelector('.ps-prev');
  var nxt=el.querySelector('.ps-next');

  // The countdown strip now lives inside each card (see buildCard's
  // timerStripHtml call), below the button — matching where the admin
  // Preview panel shows it, instead of a single bar floating above the
  // widget title outside any card. startCouponTimer runs after the cards
  // exist in the DOM since it queries for their .ps-timer-text elements.
  cards.forEach(function(item){
    w.appendChild(buildCard(tpl,item.style,item.code,item.heading,item.subtext,data,item.textOnly));
  });

  startCouponTimer(el,data,el.dataset.shop);

  /* Nav state: disable prev at start, next at end */
  function updateNavState(){
    var atStart=w.scrollLeft<=2;
    var atEnd=w.scrollLeft+w.clientWidth>=w.scrollWidth-2;
    if(prv){prv.disabled=atStart;prv.style.opacity=atStart?'0.35':'1';}
    if(nxt){nxt.disabled=atEnd;nxt.style.opacity=atEnd?'0.35':'1';}
  }

  /* Scroll by roughly one card width */
  var cardW=(cards.length>0&&w.firstChild)?w.firstChild.offsetWidth+12:280;
  if(nxt)nxt.addEventListener('click',function(){w.scrollBy({left:cardW,behavior:'smooth'});});
  if(prv)prv.addEventListener('click',function(){w.scrollBy({left:-cardW,behavior:'smooth'});});

  w.addEventListener('scroll',updateNavState);
  window.addEventListener('resize',updateNavState);
  setTimeout(updateNavState,120);

  /* Copy to clipboard */
  el.addEventListener('click',function(e){
    var btn=e.target.closest('.ps-btn');
    if(!btn)return;
    var c=btn.dataset.code,t=btn.innerText;
    if(!c)return;
    e.preventDefault();
    csCopy(c);
    var prevBg=btn.style.background,prevCol=btn.style.color;
    btn.innerText='Copied!';btn.style.background=btn.getAttribute('data-copied-bg')||'#10b981';btn.style.color=btn.getAttribute('data-copied-text')||'#fff';
    setTimeout(function(){btn.innerText=t;btn.style.background=prevBg;btn.style.color=prevCol;},2000);
  });
}

customElements.define('ps-coupon-slider',class extends HTMLElement{
  connectedCallback(){
    if(this._psInit)return;
    this._psInit=true;
    var el=this,shop=normalizeText(el.dataset.shop||(window.Shopify&&window.Shopify.shop));

    function placeWidget(apiPlacement){
      var raw=apiPlacement||el.dataset.placement||'above_atc';
      // normalize all value variants → above_atc / below_atc
      var placement=(raw==='above_cart'||raw==='top')?'above_atc':(raw==='below_cart'||raw==='bottom')?'below_atc':raw;
      if(placement==='custom'){el.style.display='block';return;}
      var atcBtn=findAtcButton();
      el.style.display='block';
      if(atcBtn){
        var anchor=atcBtn.closest('form')||atcBtn.parentNode;
        if(placement==='below_atc'){
          anchor.parentNode.insertBefore(el,anchor.nextSibling);
        }else{
          anchor.parentNode.insertBefore(el,anchor);
        }
      }
    }

    if(!shop){
      el.style.display='block';
      el.innerHTML='<p style="color:#6b7280;font-size:14px;padding:16px;">No coupons available.</p>';
      return;
    }
    if(_cache[shop]){
      getDisplayContext(el).then(function(ctx){renderSlider(el,_cache[shop],ctx);placeWidget(_cache[shop].widgetPlacement);});
      return;
    }
    var encodedShop=encodeURIComponent(shop);
    // Direct call to the PHP backend (not the Shopify App Proxy). Relies on
    // config.php's Access-Control-Allow-Origin: * — no custom headers here,
    // since those trigger a CORS preflight config.php doesn't allowlist.
    var proxyAPI='https://int.thebrix.io/save_coupon_slider_widget.php?shopdomain='+encodedShop;

    function requestJson(url){
      return fetch(url)
        .then(function(r){
          if(!r.ok)throw new Error('HTTP '+r.status);
          return r.text();
        })
        .then(function(body){
          try{return JSON.parse(body);}catch(_e){throw new Error('Invalid JSON response');}
        });
    }

    requestJson(proxyAPI)
      .then(function(res){
        if(!res||res.status!=='success'){
          el.style.display='block';
          el.innerHTML='<p style="color:#6b7280;font-size:14px;padding:16px;">No coupons available.</p>';
          return;
        }
        /* Plan gating: on Free, Coupon Lock Pro is Preview Only — the
           backend already forces is_enabled off, but never trust the
           client alone. On the live storefront, leave the element hidden.
           In the theme editor (design mode), show an upgrade placeholder
           so the merchant understands why the app embed is empty. */
        if(!res.data.is_enabled){
          if(el.dataset.designMode==='true'){
            el.style.display='block';
            el.innerHTML='<div style="padding:16px;border:1.5px dashed #d1d5db;border-radius:8px;color:#6b7280;font-size:13px;text-align:center;">🔒 Coupon Banner is not available on your current plan.<br>Upgrade to enable this widget on your storefront.</div>';
          }
          return;
        }
        _cache[shop]=res.data;
        return getDisplayContext(el).then(function(ctx){
          renderSlider(el,res.data,ctx);
          placeWidget(res.data.widgetPlacement);
        });
      })
      .catch(function(err){
        console.error('[Coupon Slider] load failed:',err&&err.message?err.message:err);
        el.style.display='block';
        el.innerHTML='<p style="color:#ef4444;font-size:14px;padding:16px;">Error loading coupons.</p>';
      });
  }
});
})();
</script>
<style>
.ps-slider{width:100%;padding:4px 0}
.ps-section-title,.ps-group-title{margin:0 0 10px}
/* Offer ladders: full-width bars above the coupon cards */
.ps-ladders{display:flex;flex-direction:column;gap:10px;margin-bottom:12px}
.ps-ladders:last-child{margin-bottom:0}
/* Row: [←] [scrollable cards] [→] */
.ps-slider-row{display:flex;align-items:center;gap:8px}
.ps-coupon-wrapper{
  flex:1;min-width:0;
  display:flex;flex-direction:row;flex-wrap:nowrap;align-items:stretch;
  gap:12px;
  overflow-x:auto;
  scrollbar-width:none;
  scroll-snap-type:x mandatory;
  -webkit-overflow-scrolling:touch;
  padding:4px 2px;
}
.ps-coupon-wrapper::-webkit-scrollbar{display:none}
.ps-card{scroll-snap-align:start;flex-shrink:0}
/* Single coupon: full width (beats the cards' fixed inline widths) */
.ps-slider--single .ps-coupon-wrapper{overflow:visible}
.ps-slider--single .ps-card{flex:1 1 100% !important;min-width:0 !important;width:100% !important;max-width:100% !important}
/* Nav arrows */
.ps-nav{
  width:34px;height:34px;border-radius:50%;
  border:1.5px solid #e2e8f0;background:#fff;
  cursor:pointer;font-size:15px;font-weight:700;
  display:flex;align-items:center;justify-content:center;
  flex-shrink:0;
  box-shadow:0 2px 6px rgba(0,0,0,0.09);
  transition:background .15s,border-color .15s,transform .1s;
  color:#374151;
  line-height:1;
}
.ps-nav:hover:not(:disabled){background:#f1f5f9;border-color:#94a3b8;transform:scale(1.08)}
.ps-nav:disabled{opacity:0.35;cursor:default}
/* List: coupons stacked, each the full width */
.ps-slider--list .ps-coupon-wrapper{flex-direction:column;overflow:visible;scroll-snap-type:none}
/* Grid: two columns, one on phones */
.ps-slider--grid .ps-coupon-wrapper{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));overflow:visible;scroll-snap-type:none}
@media (max-width:480px){.ps-slider--grid .ps-coupon-wrapper{grid-template-columns:minmax(0,1fr)}}
/* Both beat the cards' fixed inline widths */
.ps-slider--list .ps-card,.ps-slider--grid .ps-card{flex:none !important;width:100% !important;min-width:0 !important;max-width:100% !important}
</style>
