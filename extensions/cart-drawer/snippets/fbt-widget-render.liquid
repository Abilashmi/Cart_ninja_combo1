<ps-fbt-widget
  data-product-id="{{ product.id }}"
  data-shop="{{ shop.permanent_domain }}"
  data-currency="{{ shop.currency }}"
  data-product-price="{{ product.selected_or_first_available_variant.price }}"
  data-placement="{{ block.settings.placement | default: 'below_atc' }}"
  data-design-mode="{{ request.design_mode }}"
  style="display:none">
</ps-fbt-widget>

<style>
  .ps-fbt-wrapper {
    box-sizing: border-box;
    padding: var(--ps-fbt-pad, 20px);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
  }
  .ps-fbt-title {
    font-weight: 800;
    font-size: 18px;
    margin-bottom: 16px;
  }
  .ps-fbt-products {
    display: flex;
    gap: 10px;
  }
  .ps-fbt-products.carousel::-webkit-scrollbar {
    display: none;
  }
  .ps-fbt-nav {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    line-height: 1;
    cursor: pointer;
    padding: 0;
    transition: opacity 0.2s;
  }
  .ps-fbt-nav[disabled] {
    opacity: 0.35;
    pointer-events: none;
  }
  @media (max-width: 768px) {
    .ps-fbt-nav-group {
      display: none !important;
    }
  }
  .ps-fbt-products.grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .ps-product-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 10px 8px;
    border: 1px solid;
    transition: border-color 0.2s;
    position: relative;
    background: #fff;
    box-sizing: border-box;
  }
  .ps-product-main {
    display: flex;
    gap: 10px;
    min-width: 0;
    flex: 1;
  }
  .ps-product-card.horizontal .ps-product-main {
    flex-direction: column;
    align-items: flex-start;
  }
  .ps-product-image {
    width: 100%;
    height: 64px;
    border-radius: 8px;
    background-color: #f3f4f6;
    flex-shrink: 0;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ps-product-meta {
    width: 100%;
    min-width: 0;
    text-align: center;
  }
  .ps-product-title {
    font-weight: 600;
    font-size: 12px;
    line-height: 1.35;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    word-break: break-word;
  }
  .ps-product-price {
    margin-top: 4px;
    font-size: 12px;
    font-weight: 700;
  }
  .ps-product-action {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: auto;
    width: 100%;
    gap: 8px;
  }
  .ps-fbt-footer {
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .ps-fbt-addall {
    padding: 10px 22px;
    border-radius: 100px;
    cursor: pointer;
    font-weight: 800;
    border: none;
  }
  .ps-classic-btn {
    padding: 6px 12px;
    border-radius: 6px;
    cursor: pointer;
    font-weight: 700;
    font-size: 12px;
  }
  /* Merchant's hover colour (--ps-fbt-hover, set on the wrapper). */
  .ps-fbt-wrapper .ps-classic-btn:not(.is-selected):not(.ps-outline-btn):hover,
  .ps-fbt-wrapper .ps-fbt-addall:not(:disabled):not(.is-done):hover {
    background: var(--ps-fbt-hover) !important;
  }
  .ps-stepper {
    display: flex;
    border-radius: 6px;
    overflow: hidden;
  }
  .ps-stepper button {
    width: 28px;
    height: 28px;
    border: none;
    cursor: pointer;
  }
  .ps-stepper span {
    width: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ps-bundle-check {
    width: 20px;
    height: 20px;
    border: 2px solid;
    border-radius: 4px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #fff;
    transition: none;
  }
  .ps-required {
    position: absolute;
    top: -8px;
    right: -6px;
    font-size: 9px;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 4px;
  }
  @media (max-width: 768px) {
    .ps-fbt-wrapper { padding: var(--ps-fbt-pad-m, 14px); }
    .ps-product-card { min-height: auto; }
    .ps-product-main { width: 100%; }
    .ps-product-title { font-size: 13px; line-height: 1.35; -webkit-line-clamp: 3; }
    .ps-fbt-footer { flex-direction: column; align-items: stretch; gap: 10px; }
    .ps-fbt-addall { width: 100%; }
  }
</style>

<script src="{{ 'fbt_widget_render.js' | asset_url }}" defer></script>
