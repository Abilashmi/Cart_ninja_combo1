<ps-coupon-slider id="ps-coupon-slider-{{ block.id }}" data-shop="{{ shop.permanent_domain }}" data-product-handle="{{ product.handle | default: '' | downcase | escape }}" data-collection-handles="{% if product %}{% for c in product.collections %}{{ c.handle | downcase | escape }}{% unless forloop.last %},{% endunless %}{% endfor %}{% endif %}" data-product-tags="{{ product.tags | join: ',' | downcase | escape }}" data-placement="{{ block.settings.placement | default: 'above_atc' }}" data-design-mode="{{ request.design_mode }}" style="display:none"><div>Loading coupons...</div></ps-coupon-slider>
<script>
(function(){
if(customElements.get('ps-coupon-slider'))return;
var _cache={};
var _cartHandlesPromise=null;

function normalizeId(id){
  if(!id)return '';
  var clean=String(id).replace(/\\/g,'/').replace(/\/+/g,'/');
  if(clean.indexOf('gid:/')===0&&clean.indexOf('gid://')!==0)clean=clean.replace('gid:/','gid://');
  return clean;
}

function normalizeText(v){
  return String(v||'').trim().toLowerCase();
}

function asArray(v){
  if(Array.isArray(v))return v;
  if(typeof v==='string'){
    if(!v.trim())return [];
    return v.indexOf(',')!==-1?v.split(','):[v];
  }
  return [];
}

function unique(arr){
  var out=[];
  (arr||[]).forEach(function(item){
    if(item&&out.indexOf(item)===-1)out.push(item);
  });
  return out;
}

function escapeHtmlJs(v){
  return String(v==null?'':v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

/* Countdown Timer strip — saved by the admin's productwidget page (see
   save_coupon_slider_widget.php's timerEnabled/timerHours/... columns) but,
   until now, never rendered anywhere on the storefront: this file had no
   countdown markup or ticking logic at all, so turning it on in the admin
   did nothing here regardless of what was persisted. 'Session' behavior —
   the deadline is set once per browser session (sessionStorage) so it
   doesn't quietly reset back to the full duration on every page view, but
   still starts fresh for a new visit — matching the Cart Drawer's own
   countdown timer's 'session' mode (cart_drawer_inline.js). */
// timerMode 'loop': never expires — at zero it starts the same duration
// again. The cycle is anchored to the first time this device saw it
// (localStorage), so changing page doesn't restart it (same as the drawer's
// loop mode).
function getCouponTimerDeadline(shop,hours,minutes,mode){
  var durationMs=((Number(hours)||0)*3600+(Number(minutes)||0)*60)*1000;
  if(durationMs<=0)return null;
  if(mode==='loop'){
    var now=Date.now(),anchor=now;
    try{
      var loopKey='ps_coupon_timer_loop_'+shop+'_'+durationMs;
      var saved=parseInt(localStorage.getItem(loopKey)||'0',10);
      if(saved&&saved<=now)anchor=saved;else localStorage.setItem(loopKey,String(now));
    }catch(e){}
    return anchor+durationMs*(Math.floor((now-anchor)/durationMs)+1);
  }
  var key='ps_coupon_timer_deadline_'+shop;
  try{
    var stored=parseInt(sessionStorage.getItem(key)||'0',10);
    if(stored&&stored>Date.now())return stored;
    var deadline=Date.now()+durationMs;
    sessionStorage.setItem(key,String(deadline));
    return deadline;
  }catch(e){
    return Date.now()+durationMs;
  }
}

// The timer markup itself lives inside each buildCard() card now (see
// timerStripHtml below), matching the admin preview — which renders it
// below the button, inside the same card container, not as a separate bar
// floating above the widget title. A card can repeat (the slider can hold
// several coupons), so this drives every '.ps-timer-text'/'.ps-timer-label'
// pair found under el off the one shared deadline (timerEnabled/hours/mins
// are widget-level settings, not per-coupon — there's only ever one real
// countdown regardless of how many cards are showing).
function timerStripHtml(data){
  if(!data||!data.timerEnabled)return '';
  return '<div class="ps-timer-bar" style="margin-top:10px;padding:8px 14px;border-radius:6px;background:'+escapeHtmlJs(data.timerBg||'#fef2f2')+';color:'+escapeHtmlJs(data.timerText||'#991b1b')+';font-size:12px;font-weight:600;display:flex;align-items:center;justify-content:center;gap:6px;flex-wrap:wrap;">'
    +'<span class="ps-timer-label">'+escapeHtmlJs(data.timerLabel||'Offer expires in')+'</span>'
    +'<span class="ps-timer-text" style="color:'+escapeHtmlJs(data.timerAccent||'#dc2626')+';font-weight:800;letter-spacing:0.5px;"></span>'
  +'</div>';
}

function startCouponTimer(el,data,shop){
  if(!data||!data.timerEnabled)return;
  var loop=data.timerMode==='loop';
  var durationMs=((Number(data.timerHours)||0)*3600+(Number(data.timerMins)||0)*60)*1000;
  var deadline=getCouponTimerDeadline(shop,data.timerHours,data.timerMins,data.timerMode);
  if(!deadline)return;
  var pairs=Array.prototype.map.call(el.querySelectorAll('.ps-timer-text'),function(textEl){
    return {textEl:textEl,labelEl:textEl.closest('.ps-timer-bar').querySelector('.ps-timer-label')};
  });
  if(!pairs.length)return;
  var iv=null;
  function pad(n){return n<10?('0'+n):(''+n);}
  function tick(){
    var remainingMs=deadline-Date.now();
    if(remainingMs<=0&&loop){
      // Next round (skipping any that passed while the tab was asleep).
      deadline+=durationMs*(Math.floor(-remainingMs/durationMs)+1);
      remainingMs=deadline-Date.now();
    }
    if(remainingMs<=0){
      pairs.forEach(function(p){p.labelEl.textContent=data.timerExpired||'Offer expired!';p.textEl.textContent='';});
      if(iv){clearInterval(iv);iv=null;}
      return;
    }
    var totalSeconds=Math.floor(remainingMs/1000);
    var h=Math.floor(totalSeconds/3600),m=Math.floor((totalSeconds%3600)/60),s=totalSeconds%60;
    var display=h>0?(pad(h)+':'+pad(m)+':'+pad(s)):(pad(m)+':'+pad(s));
    pairs.forEach(function(p){p.textEl.textContent=display;});
  }
  tick();
  iv=setInterval(tick,1000);
}

function getCartProductHandles(){
  if(_cartHandlesPromise)return _cartHandlesPromise;
  _cartHandlesPromise=fetch('/cart.js',{credentials:'same-origin'})
    .then(function(r){return r.ok?r.json():{items:[]};})
    .then(function(cart){
      var handles=(cart&&Array.isArray(cart.items)?cart.items:[])
        .map(function(item){return normalizeText(item&&item.handle);})
        .filter(Boolean);
      return unique(handles);
    })
    .catch(function(){return[];});
  return _cartHandlesPromise;
}

function getDisplayContext(el){
  var ctx={
    productHandle:normalizeText(el.dataset.productHandle),
    collectionHandles:asArray(el.dataset.collectionHandles).map(normalizeText).filter(Boolean),
    tags:asArray(el.dataset.productTags).map(normalizeText).filter(Boolean),
    cartProductHandles:[]
  };
  return getCartProductHandles().then(function(handles){
    ctx.cartProductHandles=handles;
    return ctx;
  });
}

function findCondition(conds,id){
  var nid=normalizeId(id);
  return (conds||[]).find(function(c){
    return normalizeId(c&&c.couponId)===nid;
  })||{};
}

function matchesCondition(cond,ctx){
  var mode=cond&&cond.displayCondition?cond.displayCondition:'all';
  if(mode==='all')return true;

  if(mode==='product_handle'){
    var targets=asArray(cond.productHandles).map(normalizeText).filter(Boolean);
    if(!targets.length)return false;
    var current=unique([].concat(ctx.productHandle?[ctx.productHandle]:[],ctx.cartProductHandles||[]));
    return targets.some(function(handle){return current.indexOf(handle)!==-1;});
  }

  if(mode==='collection_handle'){
    var cTargets=asArray(cond.collectionHandles).map(normalizeText).filter(Boolean);
    if(!cTargets.length)return false;
    return cTargets.some(function(handle){return (ctx.collectionHandles||[]).indexOf(handle)!==-1;});
  }

  if(mode==='tag'){
    var tTargets=asArray(cond.displayTags).map(normalizeText).filter(Boolean);
    if(!tTargets.length)return false;
    return tTargets.some(function(tag){return (ctx.tags||[]).indexOf(tag)!==-1;});
  }

  return true;
}

function getStyles(d,tpl){
  if(tpl==='template1')return{def:d.temp1DefaultStyle||{},map:d.temp1CouponStyle||{},conds:d.temp1CouponCondition||[]};
  if(tpl==='template2')return{def:d.temp2DefaultStyle||{},map:d.temp2CouponStyle||{},conds:d.temp2CouponCondition||[]};
  return{def:d.temp3DefaultStyle||{},map:d.temp3CouponStyle||{},conds:d.temp3CouponCondition||[]};
}

