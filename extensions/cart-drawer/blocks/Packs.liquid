{%- comment -%}
  BRIX Packs — app embed that shows quantity-pack offers on product pages.
  The script ships with this extension; the Pack data comes from
  php_backend/packs_storefront.php through the app proxy (/apps/cart-app).
  PHP has no Shopify access, so the widget prices Packs from the live variant
  data below (including the product's real option names and each variant's
  option values, so the Pack's item selectors match the product's options).
  It renders nothing unless an active, verified Pack exists.
  packs_widget.js then moves it below the product price (or into the
  "BRIX Packs position" block when the Pack's placement is Custom).
{%- endcomment -%}
{% if product %}
  <div
    data-brix-packs-root
    data-shop="{{ shop.permanent_domain }}"
    data-product-id="{{ product.id }}"
    data-api="/apps/cart-app"
    data-endpoint="/apps/cart-app/packs_storefront.php"
    style="max-width:560px;margin:16px auto;padding:0 16px;"
  ></div>
  <script type="application/json" data-brix-packs-product>
    {
      "title": {{ product.title | json }},
      "image": {% if product.featured_image %}{{ product.featured_image | image_url: width: 600 | json }}{% else %}""{% endif %},
      "currency": {{ cart.currency.iso_code | json }},
      "shopCurrency": {{ shop.currency | json }},
      "options": {{ product.options | json }},
      "variants": [
        {%- for variant in product.variants -%}
          {
            "id": {{ variant.id }},
            "title": {{ variant.title | json }},
            "price": {{ variant.price | json }},
            "available": {{ variant.available | json }},
            "inventoryQuantity": {{ variant.inventory_quantity | default: 0 | json }},
            "inventoryPolicy": {{ variant.inventory_policy | json }},
            "inventoryManagement": {{ variant.inventory_management | json }},
            "options": {{ variant.options | json }},
            "image": {% if variant.featured_image %}{{ variant.featured_image | image_url: width: 480 | json }}{% else %}""{% endif %}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
  <script src="{{ 'packs_widget.js' | asset_url }}" defer></script>
{% endif %}

{%- comment -%}
  Cart page: lines that came from a BRIX Pack have their quantity fixed by the Pack,
  so the theme's quantity stepper is replaced by a "Pack of N" label on those lines only.
  Matches cart lines to form inputs by position (works with Dawn-style themes); other lines are untouched.
{%- endcomment -%}
{% if request.page_type == 'cart' %}
  <script>
    (function () {
      var busy = false;
      function apply(cart) {
        var inputs = document.querySelectorAll('input[name="updates[]"], cart-items input.quantity__input');
        var seen = {};
        Array.prototype.forEach.call(inputs, function (input) {
          var index = Number(input.getAttribute('data-index')) || 0;
          if (!index) { var all = Array.prototype.slice.call(document.querySelectorAll('input[name="updates[]"]')); index = all.indexOf(input) + 1; }
          var item = cart.items[index - 1];
          var props = item && item.properties;
          if (!props || !props._brix_pack_id) return;
          var box = input.closest('quantity-input, .quantity, .cart-item__quantity-wrapper') || input.parentElement;
          if (!box || seen[index]) return;
          seen[index] = true;
          box.style.display = 'none';
          box.setAttribute('data-brix-packs-hidden', '1');
          if (!box.parentNode.querySelector('[data-brix-packs-label="' + index + '"]')) {
            var label = document.createElement('span');
            label.setAttribute('data-brix-packs-label', index);
            label.textContent = 'Pack' + (props._brix_pack_quantity ? ' of ' + props._brix_pack_quantity : '');
            label.style.cssText = 'display:inline-block;padding:4px 10px;border-radius:999px;background:#f1f1f1;font-size:12px;font-weight:600;';
            box.parentNode.insertBefore(label, box);
          }
        });
      }
      function run() {
        if (busy) return; busy = true;
        fetch('/cart.js', { headers: { Accept: 'application/json' } })
          .then(function (r) { return r.json(); }).then(apply).catch(function () {}).then(function () { busy = false; });
      }
      run();
      // The theme re-renders the cart after quantity/remove updates.
      new MutationObserver(function () { clearTimeout(run.t); run.t = setTimeout(run, 250); }).observe(document.body, { childList: true, subtree: true });
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "BRIX Packs",
  "target": "body",
  "enabled_on": { "templates": ["product", "cart"] },
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows your BRIX Pack offers above the Add to Cart button, and hides the quantity selector for Pack items. Configure offers and design in the app's Packs page."
    }
  ]
}
{% endschema %}
